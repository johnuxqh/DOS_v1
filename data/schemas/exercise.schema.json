{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckofsweat.local/schemas/exercise.schema.json",
  "title": "Deck of Sweat Exercise",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "display_name", "equipment", "equipment_group", "movement_pattern", "primary_category", "difficulty_level", "intensity_level", "impact_level", "beginner_safe", "protocol_suitability", "strength_score", "mobility_score", "stability_score", "power_score", "conditioning_score", "status", "version", "review_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "equipment": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "equipment_group": {"type": "string", "enum": ["none", "band", "free_weight", "barbell", "portable"]},
    "movement_pattern": {"type": "string", "enum": ["squat", "hinge", "push", "pull", "carry", "rotate", "anti_rotate", "locomotion", "jump", "mobility"]},
    "primary_category": {"type": "string", "enum": ["upper_body", "lower_body", "core", "full_body", "mobility", "conditioning", "power", "stability"]},
    "secondary_categories": {"type": "array", "items": {"type": "string"}},
    "difficulty_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "intensity_level": {"type": "string", "enum": ["low", "moderate", "high"]},
    "impact_level": {"type": "string", "enum": ["low", "moderate", "high"]},
    "skill_level": {"type": "string", "enum": ["beginner", "intermediate", "advanced"]},
    "beginner_safe": {"type": "boolean"},
    "athlete_suitability": {"type": "array", "items": {"type": "string"}},
    "protocol_suitability": {"type": "array", "items": {"type": "string"}},
    "default_time_seconds": {"type": "integer", "minimum": 0},
    "default_sets": {"type": "integer", "minimum": 0},
    "coaching_cues": {"type": "array", "items": {"type": "string"}},
    "safety_notes": {"type": "array", "items": {"type": "string"}},
    "contraindications": {"type": "array", "items": {"type": "string"}},
    "strength_score": {"type": "integer", "minimum": 0, "maximum": 5},
    "mobility_score": {"type": "integer", "minimum": 0, "maximum": 5},
    "stability_score": {"type": "integer", "minimum": 0, "maximum": 5},
    "power_score": {"type": "integer", "minimum": 0, "maximum": 5},
    "conditioning_score": {"type": "integer", "minimum": 0, "maximum": 5},
    "status": {"type": "string", "enum": ["draft", "active", "retired"]},
    "review_status": {"type": "string", "enum": ["needs_review", "reviewed", "evidence_checked"]}
  }
}
